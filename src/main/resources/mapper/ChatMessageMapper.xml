<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.wcf.wcfaiagent.mapper.ChatMessageMapper">

    <resultMap id="BaseResultMap" type="ChatMessage">
        <id column="id" property="id"/>
        <result column="session_id" property="sessionId"/>
        <result column="role" property="role"/>
        <result column="content" property="content"/>
        <result column="created_at" property="createdAt"/>
    </resultMap>

    <!-- 批量插入消息（空列表由 Service 层拦截） -->
    <insert id="batchInsert">
        INSERT INTO agent_chat_message (session_id, role, content, created_at)
        VALUES
        <foreach collection="list" item="item" separator=",">
            (#{item.sessionId}, #{item.role}, #{item.content}, #{item.createdAt})
        </foreach>
    </insert>

    <!-- 某会话的全部消息（按自增 id 升序，即发送顺序） -->
    <select id="selectBySessionId" resultMap="BaseResultMap">
        SELECT id, session_id, role, content, created_at
        FROM agent_chat_message
        WHERE session_id = #{sessionId}
        ORDER BY id ASC
    </select>

    <!-- 删除某会话的全部消息 -->
    <delete id="deleteBySessionId">
        DELETE FROM agent_chat_message
        WHERE session_id = #{sessionId}
    </delete>
</mapper>
